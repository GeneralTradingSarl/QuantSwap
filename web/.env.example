# Indexer API. Leave unset on a public deployment that has no indexer: the interface then
# reads reserves straight from the chain, and falls back to the demo snapshot if the build
# enables it.
NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:4000

# RPC endpoint used for direct reads. Defaults to the chain's public endpoint.
NEXT_PUBLIC_RPC_URL=

# Chain the interface opens on before a wallet connects. Defaults to the first non-local
# deployment found in web/generated/deployments.json.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=

# Serve the captured demo dataset when neither an indexer nor a deployed chain answers.
# Every view that uses it is labelled as a snapshot.
NEXT_PUBLIC_DEMO=0
