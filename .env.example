# Copy to .env and fill in only what you need. Never commit the filled-in file.

# Deployment key for a public test network. Use a throwaway key, never a key that holds value.
PRIVATE_KEY=

# RPC endpoints for the networks you deploy to.
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# Optional: use an existing canonical WETH instead of deploying the bundled one.
WETH_ADDRESS=

# Indexer
NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
API_PORT=4000
CONFIRMATIONS=5
LOG_RANGE=2000

# Web
NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:4000
